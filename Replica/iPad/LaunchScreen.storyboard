        <capability name="Named colors" minToolsVersion="9.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0" y="0" width="1112" height="834"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchWordmark" translatesAutoresizingMaskIntoConstraints="NO" id="launch-wordmark">
                                <rect key="frame" x="222.4" y="365.7" width="667.2" height="102.6"/>
                                <color key="tintColor" red="0.19" green="0.205" blue="0.22" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
