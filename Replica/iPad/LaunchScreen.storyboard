<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25406" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" useTraitCollections="YES" launchScreen="YES" initialViewController="launch-controller">
    <device id="ipad10_5" orientation="landscape" appearance="dark"/>
    <dependencies>
